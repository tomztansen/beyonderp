			<element kind="textField" uuid="6c1f0a52-0001-4000-8000-000000000012" textAdjust="ScaleFont" x="50" y="67" width="217" height="30" fontName="Arial" fontSize="10" bold="true" blankWhenNull="true" printWhenDetailOverflows="true" vTextAlign="Top">
