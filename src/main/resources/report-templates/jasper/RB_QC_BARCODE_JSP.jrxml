			<element kind="textField" uuid="6c1f0a52-0001-4000-8000-000000000005" x="244" y="2" width="23" height="16" fontName="Arial" fontSize="10" bold="true" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["P" + $F{a5}]]></expression>
				<box leftPadding="2" rightPadding="2"/>
			</element>
			<element kind="line" uuid="6c1f0a52-0001-4000-8000-000000000006" x="0" y="0" width="269" height="1"/>
			<element kind="line" uuid="6c1f0a52-0001-4000-8000-000000000007" x="0" y="98" width="269" height="1"/>
			<element kind="line" uuid="6c1f0a52-0001-4000-8000-000000000008" x="0" y="1" width="1" height="97"/>
			<element kind="line" uuid="6c1f0a52-0001-4000-8000-000000000009" x="268" y="1" width="1" height="97"/>
			<element kind="component" uuid="6c1f0a52-0001-4000-8000-000000000010" x="3" y="51" width="46" height="46">
				<component kind="barcode4j:QRCode">
					<codeExpression><![CDATA[$F{a1}]]></codeExpression>
				</component>
			</element>
			<element kind="rectangle" uuid="6c1f0a52-0001-4000-8000-000000000011" mode="Transparent" x="3" y="51" width="46" height="46">
