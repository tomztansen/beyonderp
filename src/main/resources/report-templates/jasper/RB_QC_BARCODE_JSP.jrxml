<?xml version="1.0" encoding="UTF-8"?>
<!-- Label serial No. (rubber) 269 x 99 pt. Sumber lama: axis lp072.jrxml; geometri dipertahankan. Dipakai bersama oleh RB_QC_BARCODE_LIMIT dan RB_QC_BARCODE_AUTH. Parameter: p_from_serial, p_to_serial (rentang idno, wajib). Query ada di template (data_query kosong). Logo ga.gif ditanam sebagai base64. -->
<jasperReport name="RB_QC_BARCODE_JSP" language="java" pageWidth="269" pageHeight="99" orientation="Landscape" columnWidth="269" whenNoDataType="AllSectionsNoDetail" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="6c1f0a52-0000-4000-8000-000000000001">
	<parameter name="p_from_serial" class="java.lang.String"/>
	<parameter name="p_to_serial" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT A.idno AS a1,
       c.salesid AS a2,
       A.itemname AS a3,
       COALESCE(A.itemcode, A.itemid::text) AS a4,
       -- a5: print count ditambah 1 untuk cetakan saat ini (script AFTER yang menaikkannya di database)
       (COALESCE(ps.printcount, 0) + 1)::text AS a5,
       CASE WHEN NULLIF(btrim(b.drawingno), '') IS NULL THEN NULL
            ELSE b.drawingno || ' Rev . ' || COALESCE(b.drawingnorev::text, '') END AS a6,
       d."name" AS a7
  FROM dynamic.v_production_serial A
  LEFT JOIN dynamic.tsproductionserial ps ON ps.id = A.id
  LEFT JOIN tsproductionorder b ON A.productionno = b.idno
  LEFT JOIN tssalesline c ON b.tssaleslineid = c.id
  LEFT JOIN mscustomer d ON c.abmenduser = d."id" AND d.enduser = true
 WHERE A.isreject = FALSE
   AND A.isunique = TRUE
   AND A.msresourcegroupid = 1255
   AND lower(A.idno) BETWEEN lower($P{p_from_serial}) AND lower($P{p_to_serial})
 ORDER BY A.idno]]></query>
	<field name="a1" class="java.lang.String"/>
	<field name="a2" class="java.lang.String"/>
	<field name="a3" class="java.lang.String"/>
	<field name="a4" class="java.lang.String"/>
	<field name="a5" class="java.lang.String"/>
	<field name="a6" class="java.lang.String"/>
	<field name="a7" class="java.lang.String"/>
	<detail>
		<band height="99">
			<element kind="image" uuid="6c1f0a52-0001-4000-8000-000000000001" x="3" y="2" width="46" height="46" scaleImage="FillFrame" onErrorType="Blank" hImageAlign="Left" vImageAlign="Top">
				<expression><![CDATA[new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode(""))]]></expression>
			</element>
			<element kind="textField" uuid="6c1f0a52-0001-4000-8000-000000000002" x="156" y="18" width="153" height="33" fontName="Arial" fontSize="22" bold="true" blankWhenNull="true" printWhenDetailOverflows="true" vTextAlign="Top">
				<expression><![CDATA[$F{a1}]]></expression>
				<box leftPadding="3"/>
			</element>
			<element kind="textField" uuid="6c1f0a52-0001-4000-8000-000000000003" textAdjust="ScaleFont" x="50" y="2" width="194" height="16" fontName="Arial" fontSize="10" bold="true" blankWhenNull="true" printWhenDetailOverflows="true" vTextAlign="Middle">
				<expression><![CDATA[$F{a4}]]></expression>
