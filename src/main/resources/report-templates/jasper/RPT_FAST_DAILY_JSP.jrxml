<?xml version="1.0" encoding="UTF-8"?>
<!-- Fastener - Daily Production Output: satu baris per tanggal, qty dan berat nett estimasi (kg) per proses. GENERATED (gen_fast_daily.py).
     Pengganti report Crystal Synchro fs-daily.rpt (Include Subcon), fs-daily3.rpt (Family Group By Month) dan fs-dailyByFamily.rpt (Cutting per Family).
     p_view: PROCESS (fs-daily) | PROCESS_FAMILY (fs-daily3: Cutting/Machining Bolt-Others, QC Bolt-Washer-Others) | CUTTING_FAMILY (fs-dailyByFamily).
     p_by_month: YES = kelompokkan per bulan dengan subtotal (fs-daily3). p_subcon: INCLUDE | EXCLUDE (booking subcon, thbook.issubcon).
     Tahap = booking di resource Fastener (grup 1254) dikenali dari nama: Cutting, Forging, Heat Treatment (= Hardening+Tempering Synchro), Machining, MPI, Roll Thread, QC.
     Berat = tdbook.qty x msmethod.estnetweight (Est Nett di semua kolom, keputusan Tommy; Synchro Cutting memakai berat aktual). Family = msitem.salescategoryid.
     Query ada di template (data_query kosong). -->
<jasperReport name="RPT_FAST_DAILY" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="7d2e5b90-0000-4000-8000-0000000000aa">
	<parameter name="p_from_date" class="java.time.LocalDate"/>
	<parameter name="p_to_date" class="java.time.LocalDate"/>
	<parameter name="p_view" class="java.lang.String"/>
	<parameter name="p_by_month" class="java.lang.String"/>
	<parameter name="p_subcon" class="java.lang.String"/>
	<query language="sql"><![CDATA[WITH days AS (
  SELECT d::date AS dt FROM generate_series($P{p_from_date}::timestamp, $P{p_to_date}::timestamp, interval '1 day') d),
bk AS (
  SELECT (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date AS dt,
         CASE WHEN c.name ILIKE '%Cutting%' THEN 'CUT' WHEN c.name ILIKE '%Forging%' THEN 'FOR' WHEN c.name ILIKE '%Heat Treatment%' THEN 'HT'
              WHEN c.name ILIKE '%Machining%' THEN 'MCH' WHEN c.name ILIKE '%MPI%' THEN 'MPI' WHEN c.name ILIKE '%Roll T%' THEN 'ROL'
              WHEN c.name ILIKE '%QC%' THEN 'QC' END AS stage,
         CASE WHEN sc.name = '1.03.01.Bolt' THEN 'B' WHEN sc.name = '1.03.02.Washer' THEN 'W' WHEN sc.name = '1.03.03.Nut' THEN 'N'
              WHEN sc.name = '1.03.99.Others' THEN 'O' ELSE 'X' END AS fam,
         d.qty AS qty, COALESCE(w.estnetweight, 0) AS wt
    FROM thbook a
    JOIN mhresource r ON r.id = a.resourceid AND r.msresourcegroupid = 1254
    JOIN mdlookup c ON c.id = r.msresourceid
    JOIN tdbook d ON d.thbookid = a.id
    LEFT JOIN tsproductionorder o ON o.id = d.tsproductionorderid
    LEFT JOIN msitem i ON i.id = o.itemid
    LEFT JOIN mdlookup sc ON sc.id = i.salescategoryid
    LEFT JOIN LATERAL (SELECT m.estnetweight FROM msmethod m
                        WHERE m.itemid = o.itemid AND m.estnetweight IS NOT NULL ORDER BY m.id DESC LIMIT 1) w ON true
   WHERE (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date BETWEEN $P{p_from_date} AND $P{p_to_date}
     AND ($P{p_subcon}::text = 'INCLUDE' OR COALESCE(a.issubcon, false) = false))
SELECT days.dt AS tgl, to_char(days.dt, 'YYYY-MM') AS ym,
  COALESCE(SUM(CASE WHEN stage='CUT' THEN qty END), 0) AS cut_q,
  COALESCE(SUM(CASE WHEN stage='CUT' THEN qty * wt END), 0) AS cut_w,
  COALESCE(SUM(CASE WHEN stage='FOR' THEN qty END), 0) AS for_q,
  COALESCE(SUM(CASE WHEN stage='FOR' THEN qty * wt END), 0) AS for_w,
  COALESCE(SUM(CASE WHEN stage='HT' THEN qty END), 0) AS ht_q,
  COALESCE(SUM(CASE WHEN stage='HT' THEN qty * wt END), 0) AS ht_w,
  COALESCE(SUM(CASE WHEN stage='MCH' THEN qty END), 0) AS mch_q,
  COALESCE(SUM(CASE WHEN stage='MCH' THEN qty * wt END), 0) AS mch_w,
  COALESCE(SUM(CASE WHEN stage='MPI' THEN qty END), 0) AS mpi_q,
  COALESCE(SUM(CASE WHEN stage='MPI' THEN qty * wt END), 0) AS mpi_w,
  COALESCE(SUM(CASE WHEN stage='ROL' THEN qty END), 0) AS rol_q,
  COALESCE(SUM(CASE WHEN stage='ROL' THEN qty * wt END), 0) AS rol_w,
  COALESCE(SUM(CASE WHEN stage='QC' THEN qty END), 0) AS qc_q,
  COALESCE(SUM(CASE WHEN stage='QC' THEN qty * wt END), 0) AS qc_w,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='B' THEN qty END), 0) AS cutb_q,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='B' THEN qty * wt END), 0) AS cutb_w,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam<>'B' THEN qty END), 0) AS cuto_q,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam<>'B' THEN qty * wt END), 0) AS cuto_w,
  COALESCE(SUM(CASE WHEN stage='MCH' AND fam='B' THEN qty END), 0) AS mchb_q,
  COALESCE(SUM(CASE WHEN stage='MCH' AND fam='B' THEN qty * wt END), 0) AS mchb_w,
  COALESCE(SUM(CASE WHEN stage='MCH' AND fam<>'B' THEN qty END), 0) AS mcho_q,
  COALESCE(SUM(CASE WHEN stage='MCH' AND fam<>'B' THEN qty * wt END), 0) AS mcho_w,
  COALESCE(SUM(CASE WHEN stage='QC' AND fam='B' THEN qty END), 0) AS qcb_q,
  COALESCE(SUM(CASE WHEN stage='QC' AND fam='B' THEN qty * wt END), 0) AS qcb_w,
  COALESCE(SUM(CASE WHEN stage='QC' AND fam='W' THEN qty END), 0) AS qcw_q,
  COALESCE(SUM(CASE WHEN stage='QC' AND fam='W' THEN qty * wt END), 0) AS qcw_w,
  COALESCE(SUM(CASE WHEN stage='QC' AND fam NOT IN ('B','W') THEN qty END), 0) AS qco_q,
  COALESCE(SUM(CASE WHEN stage='QC' AND fam NOT IN ('B','W') THEN qty * wt END), 0) AS qco_w,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='W' THEN qty END), 0) AS cfw_q,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='W' THEN qty * wt END), 0) AS cfw_w,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='N' THEN qty END), 0) AS cfn_q,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='N' THEN qty * wt END), 0) AS cfn_w,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='O' THEN qty END), 0) AS cfo_q,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='O' THEN qty * wt END), 0) AS cfo_w,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='X' THEN qty END), 0) AS cfx_q,
  COALESCE(SUM(CASE WHEN stage='CUT' AND fam='X' THEN qty * wt END), 0) AS cfx_w
  FROM days LEFT JOIN bk ON bk.dt = days.dt
 GROUP BY days.dt ORDER BY days.dt]]></query>
