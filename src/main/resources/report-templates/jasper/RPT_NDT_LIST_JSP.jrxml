				<text><![CDATA[PT. GROWTH ASIA]]></text>
			</element>
			<element kind="textField" uuid="5e1c9a30-0001-4000-8000-000000000002" x="0" y="26" width="814" height="16" fontName="Arial" fontSize="9" vTextAlign="Middle">
				<expression><![CDATA["Periode: " + $P{dt_from}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm")) + " - " + $P{dt_to}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm")) + (($P{itemcode} != null && !$P{itemcode}.isBlank()) ? "    Kode produk: " + $P{itemcode} : "")]]></expression>
			</element>
			<element kind="textField" uuid="5e1c9a30-0001-4000-8000-000000000003" x="0" y="50" width="814" height="22" fontName="Arial" fontSize="14" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
