<?xml version="1.0" encoding="UTF-8"?>
<!-- Daftar NDT per serial dengan customer, deskripsi, dan total NETW. Sumber lama: axis lp081.jrxml. Report Runner: param itemcode (opsional, contains), dt_from dan dt_to (wajib). Query ada di template (data_query kosong). JUDUL punya nilai bawaan. -->
<jasperReport name="RPT_NDT_LIST_JSP" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="8d3f6b12-4a7e-4c59-b021-9e8f7a6d5c01">
	<parameter name="itemcode" class="java.lang.String"/>
	<parameter name="dt_from" class="java.time.LocalDateTime"/>
	<parameter name="dt_to" class="java.time.LocalDateTime"/>
	<parameter name="JUDUL" class="java.lang.String">
		<defaultValueExpression><![CDATA["NDT Serial List"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT b.itemcode, b.itemname, c.idno, a.estnetweight, d."name" AS status,
       e.idno AS productionorder, e.qty, f.salesid, g."name" AS enduser, i.note,
       a.inputdt, a.inputby
FROM dynamic.tsndtserial a
LEFT JOIN dynamic.msitem b ON a.msitemid = b."id"
LEFT JOIN dynamic.tsproductionserial c ON c."id" = a.tsproductionserialid
LEFT JOIN dynamic.mdlookup d ON a.statusid = d.id
LEFT JOIN dynamic.tsproductionorder e ON e."id" = a.tsproductionorderid
LEFT JOIN dynamic.tssalesline f ON e.tssaleslineid = f."id"
LEFT JOIN dynamic.mscustomer g ON g.id = f.abmenduser AND g.enduser = true
LEFT JOIN dynamic.tdproductiontag h ON a.tsproductionserialid = h.tsproductionserialid
LEFT JOIN dynamic.thproductiontag i ON h.thproductiontagid = i."id"
WHERE a.inputdt >= $P{dt_from} AND a.inputdt <= $P{dt_to}
  AND (COALESCE(CAST($P{itemcode} AS text), '') = '' OR b.itemcode ILIKE '%' || CAST($P{itemcode} AS text) || '%')
ORDER BY a.inputdt, c.idno]]></query>
	<field name="itemcode" class="java.lang.String"/>
	<field name="itemname" class="java.lang.String"/>
	<field name="idno" class="java.lang.String"/>
	<field name="estnetweight" class="java.lang.Integer"/>
	<field name="status" class="java.lang.String"/>
	<field name="productionorder" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="salesid" class="java.lang.String"/>
	<field name="enduser" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<field name="inputdt" class="java.sql.Timestamp"/>
	<field name="inputby" class="java.lang.String"/>
	<variable name="No" class="java.lang.Integer" calculation="Count">
		<expression><![CDATA[$F{idno}]]></expression>
	</variable>
	<variable name="TotalNetw" class="java.lang.Long" calculation="Sum">
		<expression><![CDATA[$F{estnetweight} == null ? 0L : Long.valueOf($F{estnetweight})]]></expression>
	</variable>
