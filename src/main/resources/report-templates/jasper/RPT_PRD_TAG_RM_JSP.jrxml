<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="RPT_PRD_TAG_RM_JSP" language="java" pageWidth="595" pageHeight="419" orientation="Landscape" columnWidth="554" leftMargin="28" rightMargin="13" topMargin="27" bottomMargin="17" uuid="7b2d4e61-5c3a-4f08-9d12-3e4a5b6c7d80">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="live postgre"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="tag_id" class="java.util.List"/>
	<parameter name="RPT_PRD_TAG_SERIAL_SUB" class="net.sf.jasperreports.engine.JasperReport"/>
	<query language="sql"><![CDATA[SELECT a.id, a.idno, a.isunique, c.itemcode, c.abmengineermaterialid, c.itemname,
       CASE WHEN b.internal = true THEN 'INTERNAL ORDER' ELSE e."name" END AS endusername,
       f.pouringtempmin, f.pouringtempmax, f.ladleweight, f.pcsperbox,
       g."name" AS pouringcuptype, a.note, f.counterweight, f.risersize, f.nozzlesize,
       h."name" AS ballasttype,
       f.coolingdays
FROM dynamic.thproductiontag a
LEFT JOIN dynamic.tsproductionorder b ON a.tsproductionorderid = b."id"
LEFT JOIN dynamic.msitem c ON b.itemid = c."id"
LEFT JOIN dynamic.tssalesline d ON b.tssaleslineid = d."id"
LEFT JOIN dynamic.mscustomer e ON d.abmenduser = e."id" AND e.enduser = true
LEFT JOIN dynamic.msmethod f ON c."id" = f.itemid
LEFT JOIN dynamic.mdlookup g ON f.pouringtypeid = g."id"
LEFT JOIN dynamic.mdlookup h ON f.ballasttypeid = h."id"
WHERE a.msresourcegroupid = 1253 AND $X{IN, a.id, tag_id}
ORDER BY a.idno]]></query>
