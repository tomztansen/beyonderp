<?xml version="1.0" encoding="UTF-8"?>
<!-- Kartu Tag produksi (RM): satu kartu A5 landscape per tag (Print dari form FO_PRD_TAG). Sumber lama: axis tagrm.jrxml.
     Data: query di template ini (data_query kosong). Param name di Designer: tag_id (FORM_FIELD, key id -> List dari baris
     form yang dicentang). Filter tetap: resource group 1253 (Foundry). Label baris ke-7 mengikuti a.isunique: true = SERIAL NUMBER /
     NO SERI / HEAT, selain itu BATCH NUMBER / NO BATCH. Isi kotak itu (semua nomor tag, satu baris dipisah koma) berasal dari subreport RPT_PRD_TAG_SERIAL_SUB, param name di Designer sama.
     PENDINGINAN (cooling days) sengaja dikosongkan. Hasil dibangkitkan; ubah koordinat langsung di sini atau di Jaspersoft Studio. -->
<jasperReport name="RPT_PRD_TAG_RM_JSP" language="java" pageWidth="595" pageHeight="419" orientation="Landscape" columnWidth="554" leftMargin="28" rightMargin="13" topMargin="27" bottomMargin="17" uuid="7b2d4e61-5c3a-4f08-9d12-3e4a5b6c7d80">
	<parameter name="tag_id" class="java.util.List"/>
	<parameter name="RPT_PRD_TAG_SERIAL_SUB" class="net.sf.jasperreports.engine.JasperReport"/>
	<query language="sql"><![CDATA[SELECT a.id, a.idno, a.isunique, c.itemcode, c.abmengineermaterialid, c.itemname,
       CASE WHEN b.internal = true THEN 'INTERNAL ORDER' ELSE e."name" END AS endusername,
       f.pouringtempmin, f.pouringtempmax, f.ladleweight, f.pcsperbox,
       g."name" AS pouringcuptype, a.note, f.counterweight, f.risersize, f.nozzlesize,
       h."name" AS ballasttype
FROM dynamic.thproductiontag a
LEFT JOIN dynamic.tsproductionorder b ON a.tsproductionorderid = b."id"
LEFT JOIN dynamic.msitem c ON b.itemid = c."id"
LEFT JOIN dynamic.tssalesline d ON b.tssaleslineid = d."id"
LEFT JOIN dynamic.mscustomer e ON d.abmenduser = e."id" AND e.enduser = true
LEFT JOIN dynamic.msmethod f ON c."id" = f.itemid
LEFT JOIN dynamic.mdlookup g ON f.pouringtypeid = g."id"
LEFT JOIN dynamic.mdlookup h ON f.ballasttypeid = h."id"
WHERE a.msresourcegroupid = 1253 AND $X{IN, a.id, tag_id}
ORDER BY a.idno]]></query>
	<field name="id" class="java.lang.Long"/>
	<field name="idno" class="java.lang.String"/>
	<field name="isunique" class="java.lang.Boolean"/>
	<field name="itemcode" class="java.lang.String"/>
	<field name="abmengineermaterialid" class="java.lang.String"/>
	<field name="itemname" class="java.lang.String"/>
	<field name="endusername" class="java.lang.String"/>
	<field name="pouringtempmin" class="java.math.BigDecimal"/>
	<field name="pouringtempmax" class="java.math.BigDecimal"/>
	<field name="ladleweight" class="java.math.BigDecimal"/>
	<field name="pcsperbox" class="java.lang.Long"/>
	<field name="pouringcuptype" class="java.lang.String"/>
	<field name="note" class="java.lang.String"/>
	<field name="counterweight" class="java.math.BigDecimal"/>
	<field name="risersize" class="java.lang.String"/>
	<field name="nozzlesize" class="java.lang.String"/>
	<field name="ballasttype" class="java.lang.String"/>
