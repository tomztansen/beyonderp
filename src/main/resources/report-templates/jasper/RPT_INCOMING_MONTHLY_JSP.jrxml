<jasperReport name="RPT_INCOMING_MONTHLY" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="30e697e9-c8df-4991-9499-ef89f546cc14">
	<parameter name="p_status" class="java.util.Collection"/>
	<parameter name="p_category" class="java.util.Collection"/>
	<parameter name="p_from_date" class="java.time.LocalDate"/>
	<parameter name="p_to_date" class="java.time.LocalDate"/>
	<parameter name="p_from_key" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{p_from_date} == null ? "" : $P{p_from_date}.toString()]]></defaultValueExpression>
	</parameter>
	<parameter name="p_to_key" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{p_to_date} == null ? "" : $P{p_to_date}.toString()]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[WITH lk AS (
  SELECT b.id, b.code FROM dynamic.mhlookup l JOIN dynamic.mdlookup b ON l.id = b.global_category_id
   WHERE l.category_code = 'MAS0067'
), src AS (
  -- Shipped & Arrived: baris Incoming (bulan = Arrival Date isian user, Qty = Qty baris)
  SELECT lk.code AS status, v.item_id, v.description, v.uom, v.procurement_category, v.arrival_date AS dt, v.qty_mt AS qty
    FROM dynamic.v_tsincoming v JOIN lk ON lk.id = v.status_id
   WHERE lk.code IN ('Shipped', 'Arrived')
  UNION ALL
  -- Outstanding: rencana (detail Arrival Plan); baris Outstanding tanpa rencana tidak tampil
  SELECT lk.code, v.item_id, v.description, v.uom, v.procurement_category, p.arrival_plan_date, p.qty
    FROM dynamic.v_tsincoming v JOIN lk ON lk.id = v.status_id
    JOIN dynamic.tsincomingplan p ON p.tsincomingid = v.id
   WHERE lk.code = 'Outstanding'
)
SELECT s.status,
       coalesce(it.itemcode, '(no item)') AS itemcode,
       coalesce(nullif(btrim(regexp_replace(s.description, '\s+', ' ', 'g')), ''), it.itemname, '(no description)') AS description,
       CASE WHEN lower(s.uom) IN ('ton', 'mt') THEN 'MT' ELSE coalesce(nullif(btrim(s.uom), ''), '-') END AS uom,
       s.procurement_category,
       CASE WHEN s.dt IS NULL THEN '9999-99' ELSE to_char(s.dt, 'YYYY-MM') END AS month_key,
       s.qty
  FROM src s
  LEFT JOIN dynamic.msitem it ON it.id = s.item_id
 WHERE s.qty IS NOT NULL
   AND $X{IN, s.status, p_status}
   AND $X{IN, s.procurement_category, p_category}
   AND (NULLIF($P{p_from_key}::text, '') IS NULL OR s.dt >= NULLIF($P{p_from_key}::text, '')::date)
   AND (NULLIF($P{p_to_key}::text, '') IS NULL OR s.dt <= NULLIF($P{p_to_key}::text, '')::date)
 ORDER BY 4, 2, 3, 6
]]></query>
	<field name="status" class="java.lang.String"/>
	<field name="itemcode" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="uom" class="java.lang.String"/>
	<field name="procurement_category" class="java.lang.String"/>
	<field name="month_key" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<title height="66">
		<element kind="textField" uuid="157bc6a0-db9b-451c-b679-a065bfd504e8" x="0" y="0" width="802" height="20" fontName="Arial" fontSize="13.0" textAdjust="ScaleFont" bold="true" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
			<box leftPadding="0" rightPadding="2">
				<pen lineWidth="0.0" lineColor="#BFBFBF"/>
			</box>
			<expression><![CDATA["INCOMING - QTY PER MONTH BY STATUS"]]></expression>
		</element>
		<element kind="textField" uuid="a48636ff-1102-4684-aa9b-de7740bd0725" x="0" y="22" width="802" height="14" fontName="Arial" fontSize="8.0" textAdjust="ScaleFont" bold="false" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
			<box leftPadding="0" rightPadding="2">
				<pen lineWidth="0.0" lineColor="#BFBFBF"/>
			</box>
			<expression><![CDATA["Status : " + ($P{p_status} == null || $P{p_status}.isEmpty() ? "All (Outstanding + Shipped + Arrived)" : String.join(", ", $P{p_status})) + "     Month : " + ($P{p_from_date} == null && $P{p_to_date} == null ? "All" : (($P{p_from_date} == null ? "..." : $P{p_from_date}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy"))) + " to " + ($P{p_to_date} == null ? "..." : $P{p_to_date}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")))))]]></expression>
		</element>
		<element kind="textField" uuid="d09818d1-242b-4304-8a1e-7c6fce87ec80" x="0" y="36" width="802" height="14" fontName="Arial" fontSize="8.0" textAdjust="ScaleFont" bold="false" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
			<box leftPadding="0" rightPadding="2">
				<pen lineWidth="0.0" lineColor="#BFBFBF"/>
			</box>
			<expression><![CDATA["Outstanding = Arrival Plan (detail); Shipped & Arrived = Arrival Date & Qty of the Incoming row. (blank) = no Arrival Date"]]></expression>
		</element>
		<element kind="textField" uuid="a234be8b-7248-456d-af0b-606df703a0c0" x="0" y="50" width="802" height="14" fontName="Arial" fontSize="8.0" textAdjust="StretchHeight" bold="false" blankWhenNull="true" hTextAlign="Left" vTextAlign="Top">
			<box leftPadding="0" rightPadding="2">
				<pen lineWidth="0.0" lineColor="#BFBFBF"/>
			</box>
			<expression><![CDATA["Procurement Category : " + ($P{p_category} == null || $P{p_category}.isEmpty() ? "All" : String.join(", ", $P{p_category}))]]></expression>
		</element>
	</title>
