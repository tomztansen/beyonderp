<?xml version="1.0" encoding="UTF-8"?>
<!-- PPIC - Daily Production Output (Foundry): satu baris per tanggal, berat (kg) tiap tahap produksi.
     Pengganti report Crystal Synchro "PPIC - Daily Production Output" (Dailyprodnew.rpt). Param: p_from_date, p_to_date (DATE, inklusif).
     Tahap = booking di resource Foundry (thbook.resourceid, mhresource grup 1253), dikenali dari nama resource:
       Moulding = Moulding (Est Gross), Casting Gross/Nett = Melting (berat AKTUAL bila >0, selain itu Est),  Knock Out / Fettling / Harden (=Heat Treatment) /
       Finishing (=Final Finishing) / QC (=Final QC) = Est Nett. Berat = tdbook.qty x msmethod (metode terbaru yg estnetweight terisi).
     Sama seperti Synchro (keputusan Tommy): Casting pakai rumus campuran aktual-jika-ada; Finishing = semua keluaran Final Finishing.
     Beda dari Synchro: kolom Temper tidak ada (GMS tak punya resource Temper; Heat Treatment mencakup hardening+temper); baris Total mencakup semua kolom.
     Query ada di template (data_query kosong). -->
<jasperReport name="RPT_PPIC_DAILY" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="7d2e5b90-0000-4000-8000-00000000c100">
	<parameter name="p_from_date" class="java.time.LocalDate"/>
	<parameter name="p_to_date" class="java.time.LocalDate"/>
	<query language="sql"><![CDATA[WITH days AS (
  SELECT d::date AS dt FROM generate_series($P{p_from_date}::timestamp, $P{p_to_date}::timestamp, interval '1 day') d),
bk AS (
  SELECT (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date AS dt,
         CASE WHEN c.name ILIKE '%Moulding%' THEN 'MOULD' WHEN c.name ILIKE '%Melting%' THEN 'MELT' WHEN c.name ILIKE '%Knock Out%' THEN 'KO'
              WHEN c.name ILIKE '%Fettling%' THEN 'FET' WHEN c.name ILIKE '%Heat Treatment%' THEN 'HT' WHEN c.name ILIKE '%Final Finishing%' THEN 'FIN'
              WHEN c.name ILIKE '%Final QC%' THEN 'QC' END AS stage,
         d.qty, w.estgrossweight, w.estnetweight, w.grossweight, w.netweight
    FROM thbook a
    JOIN mhresource r ON r.id = a.resourceid AND r.msresourcegroupid = 1253
    JOIN mdlookup c ON c.id = r.msresourceid
    JOIN tdbook d ON d.thbookid = a.id
    LEFT JOIN tsproductionorder o ON o.id = d.tsproductionorderid
    LEFT JOIN LATERAL (SELECT m.estgrossweight, m.estnetweight, m.grossweight, m.netweight FROM msmethod m
                        WHERE m.itemid = o.itemid AND m.estnetweight IS NOT NULL ORDER BY m.id DESC LIMIT 1) w ON true
   WHERE (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date BETWEEN $P{p_from_date} AND $P{p_to_date})
SELECT days.dt AS tgl,
  COALESCE(SUM(CASE WHEN stage = 'MOULD' THEN qty * COALESCE(estgrossweight, 0) END), 0) AS moulding,
  COALESCE(SUM(CASE WHEN stage = 'MELT' THEN qty * CASE WHEN grossweight > 0 THEN grossweight ELSE COALESCE(estgrossweight, 0) END END), 0) AS casting_gross,
  COALESCE(SUM(CASE WHEN stage = 'MELT' THEN qty * CASE WHEN netweight > 0 THEN netweight ELSE COALESCE(estnetweight, 0) END END), 0) AS casting_nett,
  COALESCE(SUM(CASE WHEN stage = 'KO' THEN qty * COALESCE(estnetweight, 0) END), 0) AS knock_out,
  COALESCE(SUM(CASE WHEN stage = 'FET' THEN qty * COALESCE(estnetweight, 0) END), 0) AS fettling,
  COALESCE(SUM(CASE WHEN stage = 'HT' THEN qty * COALESCE(estnetweight, 0) END), 0) AS harden,
  COALESCE(SUM(CASE WHEN stage = 'FIN' THEN qty * COALESCE(estnetweight, 0) END), 0) AS finishing,
  COALESCE(SUM(CASE WHEN stage = 'QC' THEN qty * COALESCE(estnetweight, 0) END), 0) AS qc
  FROM days LEFT JOIN bk ON bk.dt = days.dt
 GROUP BY days.dt ORDER BY days.dt]]></query>
	<field name="tgl" class="java.sql.Date"/>
	<field name="moulding" class="java.math.BigDecimal"/>
	<field name="casting_gross" class="java.math.BigDecimal"/>
	<field name="casting_nett" class="java.math.BigDecimal"/>
	<field name="knock_out" class="java.math.BigDecimal"/>
	<field name="fettling" class="java.math.BigDecimal"/>
	<field name="harden" class="java.math.BigDecimal"/>
	<field name="finishing" class="java.math.BigDecimal"/>
	<field name="qc" class="java.math.BigDecimal"/>
	<variable name="t_moulding" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{moulding}]]></expression></variable>
	<variable name="t_cgross" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{casting_gross}]]></expression></variable>
	<variable name="t_cnett" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{casting_nett}]]></expression></variable>
	<variable name="t_ko" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{knock_out}]]></expression></variable>
	<variable name="t_fet" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{fettling}]]></expression></variable>
	<variable name="t_harden" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{harden}]]></expression></variable>
	<variable name="t_fin" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{finishing}]]></expression></variable>
	<variable name="t_qc" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{qc}]]></expression></variable>
