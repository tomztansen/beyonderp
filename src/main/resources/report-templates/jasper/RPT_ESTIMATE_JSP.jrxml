	<variable name="sumHrs" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{p_hrs} == null ? null : new java.math.BigDecimal($F{p_hrs}.toString())]]></expression>
	</variable>
	<variable name="sumLab" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{p_labcost} == null ? null : new java.math.BigDecimal($F{p_labcost}.toString())]]></expression>
	</variable>
	<variable name="sumVar" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{p_varcost} == null ? null : new java.math.BigDecimal($F{p_varcost}.toString())]]></expression>
	</variable>
	<variable name="sumFix" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{p_fixcost} == null ? null : new java.math.BigDecimal($F{p_fixcost}.toString())]]></expression>
	</variable>
	<variable name="sumUtil" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{p_utilcost} == null ? null : new java.math.BigDecimal($F{p_utilcost}.toString())]]></expression>
	</variable>
	<variable name="sumTotal" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{p_total} == null ? null : new java.math.BigDecimal($F{p_total}.toString())]]></expression>
	</variable>
	<variable name="sumBom" resetType="Group" resetGroup="SecGroup" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{b_cost} == null ? null : new java.math.BigDecimal($F{b_cost}.toString())]]></expression>
	</variable>
	<group name="EstGroup" startNewPage="true">
		<expression><![CDATA[$F{est_id}]]></expression>
