				<element kind="staticText" x="445" y="48" width="6" height="11" fontName="Arial" fontSize="7.0"><text><![CDATA[:]]></text></element>
				<element kind="textField" x="451" y="48" width="104" height="11" fontName="Arial" fontSize="7.0" blankWhenNull="true"><expression><![CDATA[$F{estimatenumber}]]></expression></element>
				<element kind="staticText" x="380" y="59" width="65" height="11" fontName="Arial" fontSize="7.0"><text><![CDATA[Estimation Date]]></text></element>
				<element kind="staticText" x="445" y="59" width="6" height="11" fontName="Arial" fontSize="7.0"><text><![CDATA[:]]></text></element>
				<element kind="textField" x="451" y="59" width="104" height="11" fontName="Arial" fontSize="7.0" blankWhenNull="true" pattern="dd/MM/yyyy"><expression><![CDATA[$F{estimatedate}]]></expression></element>
				<element kind="staticText" x="380" y="70" width="65" height="11" fontName="Arial" fontSize="7.0"><text><![CDATA[Last Update]]></text></element>
