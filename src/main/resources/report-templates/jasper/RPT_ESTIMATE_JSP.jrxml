<?xml version="1.0" encoding="UTF-8"?>
<!-- RPT_ESTIMATE: laporan Estimation (ex GA/FM/ES-004) untuk Print dari form ALL_EST. Satu halaman per estimate (grup est_id).
     Tanpa blok Metal; Cost Summary mulai di kolom kanan sejajar tabel BOM; "BOM Cost" -> "Material Cost".
     Tanpa subreport: satu query dengan penanda seksi (sec 1 = proses, sec 2 = BOM berdampingan dengan baris Cost Summary).
     Parameter STANDARD_LOCALE (nilai tidak dipakai) = penanda opt-in: JasperRenderer mengisi REPORT_LOCALE dari
     Standard Format (NUMBER_LOCALE) bila template mendeklarasikannya.
     Rumus Cost Summary: Production = Material + Process + Factory OH; Del & Gam = Office OH + Transport; Total = Production + Del & Gam;
     Technical/Commercial Risk = Total x persen; Sugt Selling Prc = (Total + risiko) / (1 - Margin% - Commission%); Commission = Sugt x persen.
     Process Cost / Factory OH / Office OH memakai jam per pcs (routinghour / perseries), sama dengan form ALL_EST. -->
<jasperReport name="RPT_ESTIMATE_JSP" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e5714a10-0c11-4b6e-9d21-5a3c7e000001">
	<style name="SumRow" mode="Transparent" fontName="Arial" fontSize="7.0">
		<conditionalStyle mode="Opaque" backcolor="#DCE6F2" bold="true">
			<conditionExpression><![CDATA["H".equals($F{s_style})]]></conditionExpression>
		</conditionalStyle>
		<conditionalStyle mode="Opaque" backcolor="#A9C0DD" bold="true">
			<conditionExpression><![CDATA["T".equals($F{s_style})]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="est_id" class="java.util.List"/>
	<parameter name="STANDARD_LOCALE" class="java.lang.Boolean"/>
	<query language="sql"><![CDATA[WITH e1 AS (
  SELECT h.id, h.estimatenumber, h.estimatedate, COALESCE(h.updatedt, h.inputdt)::date AS lastupdate,
         h.quatationno, h.qty, h.qtybox, h.annualusage, h.estgrossweight, h.estnetweight, h.grossweight, h.netweight,
         h.drawingnumber, h.drawingnumberrev, h.ispatterntrial, h.ismodmethod, h.ismoddrawing,
         COALESCE(h.technicalriskcost, 0) AS techpct, COALESCE(h.commercialriskcost, 0) AS commpct,
         COALESCE(h.commission, 0) AS comsnpct, COALESCE(h.margin, 0) AS marginpct,
         COALESCE(h.transportcost, 0) AS transport,
         c."name" AS customer, m.itemcode, m.itemname,
         dt.code AS deliveryterm, dp.code AS deliveryplace,
         COALESCE(u.full_name, h.inputby) AS preparedby,
         COALESCE((SELECT sum(b.qtybom * b.priceunit / nullif(b.perseries, 0))
                     FROM dynamic.tsestimatebom b WHERE b.tsestimateid = h.id), 0) AS matc,
         COALESCE((SELECT sum(r.routinghour * r.labourrate   / nullif(r.perseries, 0)
                            + r.routinghour * r.fixedrate    / nullif(r.perseries, 0)
                            + h.estnetweight * r.utilityrate
                            + r.routinghour * r.variablerate / nullif(r.perseries, 0))
                     FROM dynamic.tsestimateroute r WHERE r.tsestimateid = h.id), 0) AS procc,
         COALESCE((SELECT sum(r.routinghour / nullif(r.perseries, 0))
                     FROM dynamic.tsestimateroute r WHERE r.tsestimateid = h.id), 0) AS hrs,
         COALESCE(h.factoryoverheadcost, 0) AS fohrate, COALESCE(h.generaloverheadcost, 0) AS gohrate
    FROM dynamic.tsestimate h
    LEFT JOIN dynamic.mscustomer c ON c.id = h.mscustomerid
    LEFT JOIN dynamic.msitem m ON m.id = h.msitemid
    LEFT JOIN dynamic.mdlookup dt ON dt.id = h.deliverytermid
    LEFT JOIN dynamic.mdlookup dp ON dp.id = h.destinationid
    LEFT JOIN dynamic.v_users u ON u.username = h.inputby
   WHERE $X{IN, h.id, est_id}
), e2 AS (
  SELECT e1.*, e1.hrs * e1.fohrate AS foh, e1.hrs * e1.gohrate AS goh,
         e1.matc + e1.procc + e1.hrs * e1.fohrate AS prodcost
    FROM e1
), e3 AS (
  SELECT e2.*, e2.goh + e2.transport AS delgam, e2.prodcost + e2.goh + e2.transport AS totalcost
    FROM e2
), e4 AS (
  SELECT e3.*, e3.totalcost * e3.techpct / 100 AS techrisk, e3.totalcost * e3.commpct / 100 AS commrisk
    FROM e3
), e5 AS (
  SELECT e4.*, (e4.totalcost + e4.techrisk + e4.commrisk) / nullif(1 - e4.marginpct / 100 - e4.comsnpct / 100, 0) AS sell
    FROM e4
), e AS (
  SELECT e5.*, e5.sell * e5.comsnpct / 100 AS commissionamt FROM e5
)
SELECT * FROM (
  SELECT e.id AS est_id, e.estimatenumber, e.estimatedate, e.lastupdate, e.quatationno, e.qty, e.qtybox, e.annualusage,
         e.estgrossweight, e.estnetweight, e.grossweight, e.netweight, e.drawingnumber, e.drawingnumberrev,
         e.ispatterntrial, e.ismodmethod, e.ismoddrawing, e.customer, e.itemcode, e.itemname,
         e.deliveryterm, e.deliveryplace, e.preparedby,
         1 AS sec, r.id AS ord,
         d.description AS p_name, r.routinghour AS p_hrs, r.perseries AS p_per,
         r.labourrate AS p_labrate, r.routinghour * r.labourrate / nullif(r.perseries, 0) AS p_labcost,
         r.variablerate AS p_varrate, r.routinghour * r.variablerate / nullif(r.perseries, 0) AS p_varcost,
         r.fixedrate AS p_fixrate, r.routinghour * r.fixedrate / nullif(r.perseries, 0) AS p_fixcost,
         e.estnetweight * r.utilityrate AS p_utilcost,
         COALESCE(r.routinghour * r.labourrate / nullif(r.perseries, 0), 0)
           + COALESCE(r.routinghour * r.fixedrate / nullif(r.perseries, 0), 0)
           + COALESCE(e.estnetweight * r.utilityrate, 0)
           + COALESCE(r.routinghour * r.variablerate / nullif(r.perseries, 0), 0) AS p_total,
         NULL::text AS b_code, NULL::text AS b_desc, NULL::numeric AS b_qty, NULL::numeric AS b_price, NULL::numeric AS b_cost,
         NULL::text AS s_label, NULL::numeric AS s_val, NULL::text AS s_fmt, NULL::text AS s_style
    FROM e
    JOIN dynamic.tsestimateroute r ON r.tsestimateid = e.id
    LEFT JOIN dynamic.mhresource mh ON mh.id = r.msresourceid
    LEFT JOIN dynamic.mdlookup d ON d.id = mh.msresourceid
  UNION ALL
  SELECT e.id, e.estimatenumber, e.estimatedate, e.lastupdate, e.quatationno, e.qty, e.qtybox, e.annualusage,
         e.estgrossweight, e.estnetweight, e.grossweight, e.netweight, e.drawingnumber, e.drawingnumberrev,
         e.ispatterntrial, e.ismodmethod, e.ismoddrawing, e.customer, e.itemcode, e.itemname,
         e.deliveryterm, e.deliveryplace, e.preparedby,
         2, g.rn::bigint,
         NULL::text, NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric,
         NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric,
         bi.itemcode, bi.itemname, bb.qtybom, bb.priceunit, bb.qtybom * bb.priceunit / nullif(bb.perseries, 0),
         sm.label, sm.val, sm.fmt, sm.style
    FROM e
   CROSS JOIN LATERAL generate_series(1, GREATEST(18, (SELECT count(*) FROM dynamic.tsestimatebom x WHERE x.tsestimateid = e.id))::int) AS g(rn)
    LEFT JOIN LATERAL (SELECT b2.*, row_number() OVER (ORDER BY b2.id) AS rn
                         FROM dynamic.tsestimatebom b2 WHERE b2.tsestimateid = e.id) bb ON bb.rn = g.rn
    LEFT JOIN dynamic.msitem bi ON bi.id = bb.msitemid
    LEFT JOIN LATERAL (SELECT v.n, v.label, v.val, v.fmt, v.style FROM (VALUES
         (1,  'Material Cost',      e.matc,                                  'M', 'N'),
         (2,  'Process Cost',       e.procc,                                 'M', 'N'),
         (3,  'Factory OH',         e.foh,                                   'M', 'N'),
         (4,  'Production Cost',    e.prodcost,                              'M', 'H'),
         (5,  'Office Overhead',    e.goh,                                   'M', 'N'),
         (6,  'Transport Cost',     e.transport,                             'M', 'N'),
         (7,  'Del & Gam Cost',     e.delgam,                                'M', 'H'),
         (8,  'Total Cost',         e.totalcost,                             'M', 'T'),
         (9,  'Technical Risk',     e.techrisk,                              'M', 'N'),
         (10, 'Commercial Risk',    e.commrisk,                              'M', 'N'),
         (11, 'Commission',         e.commissionamt,                         'M', 'N'),
         (12, 'Margin',             e.marginpct,                             'P', 'N'),
         (13, 'Sugt Selling Prc',   e.sell,                                  'M', 'T'),
         (14, 'Act Selling Price',  NULL::numeric,                           'M', 'N'),
         (15, 'Selling Price/kg',   e.sell      / nullif(e.estnetweight, 0), 'M', 'N'),
         (16, 'Prod. Cost/kg',      e.prodcost  / nullif(e.estnetweight, 0), 'M', 'N'),
         (17, 'Del &GAM Cost/kg',   e.delgam    / nullif(e.estnetweight, 0), 'M', 'N'),
         (18, 'Total Cost/kg',      e.totalcost / nullif(e.estnetweight, 0), 'M', 'N')
       ) AS v(n, label, val, fmt, style)) sm ON sm.n = g.rn
) x
ORDER BY est_id, sec, ord]]></query>
