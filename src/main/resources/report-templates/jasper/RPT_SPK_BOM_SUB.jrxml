<?xml version="1.0" encoding="UTF-8"?>
<!-- Sub-report: Production BOM (Kebutuhan Bahan Baku / Material) -->
<jasperReport name="RPT_SPK_BOM_SUB" pageWidth="555" pageHeight="842" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    <parameter name="P_ORDER_ID" class="java.lang.Object"/>

    <query language="sql"><![CDATA[
        SELECT 
            COALESCE(i.itemcode, 'MAT-' || b.materialid) AS material_code,
            COALESCE(i.itemname, 'Item ' || b.materialid) AS material_name,
            COALESCE(g.code, 'Raw Material') AS material_group,
            b.qty,
            b.perseries,
            COALESCE(u.code, 'PCS') AS uom_name
        FROM dynamic.tsproductionorderbomd b
        LEFT JOIN dynamic.msitem i ON b.materialid = i.id
        LEFT JOIN dynamic.mdlookup g ON b.materialgroupid = g.id
        LEFT JOIN dynamic.mdlookup u ON b.uomid = u.id
        WHERE b.tsproductionorderid = $P{P_ORDER_ID}
        ORDER BY b.id ASC
    ]]></query>

    <field name="material_code" class="java.lang.String"/>
    <field name="material_name" class="java.lang.String"/>
    <field name="material_group" class="java.lang.String"/>
    <field name="qty" class="java.math.BigDecimal"/>
    <field name="perseries" class="java.math.BigDecimal"/>
    <field name="uom_name" class="java.lang.String"/>

    <title height="24">
        <element kind="staticText" x="0" y="4" width="555" height="18" fontSize="11.0" bold="true">
            <text><![CDATA[B. DAFTAR KEBUTUHAN MATERIAL (BILL OF MATERIAL - BOM)]]></text>
        </element>
    </title>

    <columnHeader height="20">
        <element kind="line" x="0" y="0" width="555" height="1"/>
        <element kind="staticText" x="0" y="2" width="100" height="16" bold="true">
            <text><![CDATA[Kode Bahan]]></text>
        </element>
        <element kind="staticText" x="100" y="2" width="220" height="16" bold="true">
            <text><![CDATA[Nama Bahan / Spesifikasi]]></text>
        </element>
        <element kind="staticText" x="320" y="2" width="90" height="16" bold="true">
            <text><![CDATA[Kelompok]]></text>
        </element>
        <element kind="staticText" x="410" y="2" width="70" height="16" bold="true" hTextAlign="Right">
            <text><![CDATA[Kebutuhan]]></text>
        </element>
        <element kind="staticText" x="485" y="2" width="70" height="16" bold="true">
            <text><![CDATA[Satuan]]></text>
        </element>
        <element kind="line" x="0" y="19" width="555" height="1"/>
    </columnHeader>

    <detail>
        <band height="18">
            <element kind="textField" x="0" y="1" width="100" height="16" blankWhenNull="true">
                <expression><![CDATA[$F{material_code}]]></expression>
            </element>
            <element kind="textField" x="100" y="1" width="220" height="16" blankWhenNull="true">
                <expression><![CDATA[$F{material_name}]]></expression>
            </element>
            <element kind="textField" x="320" y="1" width="90" height="16" blankWhenNull="true">
                <expression><![CDATA[$F{material_group}]]></expression>
            </element>
            <element kind="textField" x="410" y="1" width="70" height="16" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right">
                <expression><![CDATA[$F{qty}]]></expression>
            </element>
            <element kind="textField" x="485" y="1" width="70" height="16" blankWhenNull="true">
                <expression><![CDATA[$F{uom_name}]]></expression>
            </element>
        </band>
    </detail>
</jasperReport>
