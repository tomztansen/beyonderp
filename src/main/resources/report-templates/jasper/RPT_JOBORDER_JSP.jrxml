<jasperReport name="RPT_JOBORDER_JSP" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a10fc1bb-4781-40f1-8fcc-6f7c82c81ecf">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="live postgre"/>
	<parameter name="prod_id" class="java.util.List"/>
	<parameter name="RPT_PO_ROUTE_SUB" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="RPT_PO_NOTES_SUB" class="net.sf.jasperreports.engine.JasperReport"/>
	<query language="sql"><![CDATA[select a.*,
b.salesid,b.abmexternallinenumber,b.externalitemid,
c.itemcode,c.itemname,
d.itemcode itemcodeset,d.itemname itemnameset,
b.qtyordered,
e.estnetweight,e.grossweight,e.netweight,
e.hardness,c.abmengineermaterialid,
f."name" enduser,g.code categoryname,
h.code scope,b.abmisitemset isitemset,i."name" customer,
e.estgrossweight,j.description toolingtype,
c.note
 from dynamic.tsproductionorder a
left join dynamic.tssalesline b on a.tssaleslineid = b.id
left join dynamic.msitem c on a.itemid = c.id
left join dynamic.msitem d on b.itemsetid = d."id"
left join dynamic.msmethod e on a.itemid = e.itemid
left join dynamic.mscustomer f on b.abmenduser = f."id" and f.enduser = true
left join dynamic.mdlookup g on c.salescategoryid = g."id"
left join dynamic.mdlookup h on e.scopeid = h.id
left join dynamic.mscustomer i on b.invoiceaccount = i."id" and i.enduser = false
left join dynamic.mdlookup j on a.toolingtypeid = j."id"
where $X{IN, a.id, prod_id}
order by a.id]]></query>
