<jasperReport name="RPT_LP071_SERIAL_LABEL" language="java" pageWidth="198" pageHeight="102" orientation="Landscape" columnWidth="194" leftMargin="2" rightMargin="2" topMargin="2" bottomMargin="2" uuid="ad3e7243-fcfa-4208-9b76-0426fc923160">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="local postgre"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="pserial" class="java.lang.String">
		<defaultValueExpression><![CDATA["b60409,b60410,c00001"]]></defaultValueExpression>
	</parameter>
	<parameter name="plocation_label" class="java.lang.String">
		<defaultValueExpression><![CDATA["finis"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
    A.idno AS a1,
    COALESCE(q2.hthardno, '-') AS a2,
    COALESCE(A.itemname, '-') AS a3,
    COALESCE(A.itemcode, A.itemid::text) AS a4,
    -- a5: Nilai print count ditambah 1 otomatis untuk cetakan saat ini
    (COALESCE(ps.printcount, 0) + 1)::text AS a5
FROM dynamic.v_production_serial A 
-- Join ke tabel fisik tsproductionserial via Primary Key untuk ambil printcount
LEFT JOIN dynamic.tsproductionserial ps 
    ON ps.id = A.id
LEFT JOIN LATERAL (
    SELECT
        th.hthardno,
        th.bookdate 
    FROM dynamic.tdbook d
    JOIN dynamic.thbook th ON d.thbookid = th.id
    JOIN dynamic.mhresource b ON th.resourceid = b.id
    JOIN dynamic.mdlookup c ON b.msresourceid = c.id 
        AND c.code ILIKE '%Foundry - Heat%'
    WHERE d.serialid = A.id 
    ORDER BY d.id DESC 
    LIMIT 1 
) q2 ON TRUE 
WHERE lower(A.idno) = ANY(string_to_array(lower(replace($P{pserial}, ' ', '')), ','))
  AND A.isreject = FALSE 
  AND A.isunique = TRUE 
 AND ($P{plocation_label}::text IS NULL OR $P{plocation_label}::text = '' OR A.current_resourcename ILIKE '%' || $P{plocation_label} || '%')
ORDER BY A.idno;]]></query>
	<field name="a1" class="java.lang.String"/>
	<field name="a2" class="java.lang.String"/>
	<field name="a3" class="java.lang.String"/>
	<field name="a4" class="java.lang.String"/>
	<field name="a5" class="java.lang.String"/>
