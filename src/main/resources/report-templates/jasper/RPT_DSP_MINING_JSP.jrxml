<?xml version="1.0" encoding="UTF-8"?>
<!-- DSP - Mining Summary (GENERATED oleh gen_dsp_mining.py): pesanan (OC/job) beserta qty yang sudah ada di gudang Despatch, dikelompokkan per end user.
     Pengganti report Crystal Synchro "DSP - Mining Summary" (DspSum.rpt, id 451). Sumber Synchro: ORDE_Goods/ORDE_Orders/PROD_Product (job) + Unique_Bookings di langkah Picking & Shipping / Packaging (Qty DSP).
     Sumber GMS: tssalesline (OC, qtyordered, end user abmenduser) + tsproductionorder (job idno) + stok serial di gudang "GA Foundry - Despatch" (saldo tdinventorymovement per serial > 0) + msmethod.estnetweight.
     Keputusan Tommy: O/S TO DSP memakai RUMUS BARU = QtyOrdered - QtyDsp (Synchro: SUM(Quantity) - Outstanding_Qty, keliru); kolom O/S DLV QTY (Outstanding_Qty = Order_Qty - To_Cust_Qty) dihilangkan (pengiriman belum tertaut ke order di GMS).
     Item 3RMCAS% dan GA-Z% dikecualikan (seperti Synchro). Hanya job dengan Qty DSP > 0. Tanpa parameter. Query ada di template (data_query kosong). -->
<jasperReport name="RPT_DSP_MINING" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="7d2e5b90-0000-4000-8000-0000000000ee">
	<query language="sql"><![CDATA[WITH dsp AS (
  -- stok serial di gudang Despatch Foundry = saldo pergerakan inventori per serial > 0 (qty bertanda: masuk +, keluar -; sama dgn v_inventory_movement)
  SELECT d.tsproductionserialid AS serialid, SUM(d.qty) AS saldo
    FROM tdinventorymovement d
    JOIN thinventorymovement h ON h.id = d.hid
    JOIN mdlookup w ON w.id = h.mswarehouseid AND w.name ILIKE '%Despatch%' AND w.name ILIKE '%Foundry%'
   WHERE d.tsproductionserialid IS NOT NULL
   GROUP BY d.tsproductionserialid HAVING SUM(d.qty) > 0)
SELECT COALESCE(cu.name, ' STOK ORDER') AS end_user,
       i.itemcode, i.itemname AS descr, s.salesid AS oc, po.idno AS job_number,
       s.qtyordered, SUM(dsp.saldo) AS qty_dsp,
       s.qtyordered - SUM(dsp.saldo) AS os_to_dsp,
       w2.estnetweight AS estwt,
       SUM(dsp.saldo) * COALESCE(w2.estnetweight, 0) AS total
  FROM dsp
  JOIN v_production_serial vs ON vs.id = dsp.serialid
  JOIN tsproductionorder po ON po.id = vs.tsproductionorderid
  LEFT JOIN tssalesline s ON s.id = po.tssaleslineid
  JOIN msitem i ON i.id = po.itemid AND i.itemcode NOT LIKE '3RMCAS%' AND i.itemcode NOT LIKE 'GA-Z%'
  LEFT JOIN mscustomer cu ON cu.id = s.abmenduser AND cu.enduser = true
  LEFT JOIN LATERAL (SELECT m.estnetweight FROM msmethod m WHERE m.itemid = po.itemid AND m.estnetweight IS NOT NULL ORDER BY m.id DESC LIMIT 1) w2 ON true
 GROUP BY cu.name, i.itemcode, i.itemname, s.salesid, po.idno, s.qtyordered, w2.estnetweight
 ORDER BY 1, 2, 4, 5]]></query>
	<field name="end_user" class="java.lang.String"/>
	<field name="itemcode" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="oc" class="java.lang.String"/>
	<field name="job_number" class="java.lang.String"/>
	<field name="qtyordered" class="java.math.BigDecimal"/>
	<field name="qty_dsp" class="java.math.BigDecimal"/>
	<field name="os_to_dsp" class="java.math.BigDecimal"/>
	<field name="estwt" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="g_dsp" class="java.math.BigDecimal" resetType="Group" resetGroup="g_user" calculation="Sum"><expression><![CDATA[$F{qty_dsp}]]></expression></variable>
	<variable name="g_tot" class="java.math.BigDecimal" resetType="Group" resetGroup="g_user" calculation="Sum"><expression><![CDATA[$F{total}]]></expression></variable>
	<variable name="t_dsp" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{qty_dsp}]]></expression></variable>
	<variable name="t_tot" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{total}]]></expression></variable>
