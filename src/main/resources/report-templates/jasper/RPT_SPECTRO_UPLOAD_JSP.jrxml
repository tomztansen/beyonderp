				<text><![CDATA[]]></text>
				<box><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="staticText" uuid="7d2e5b90-0000-4000-8000-0000000000a3" x="210" y="0" width="118" height="13" fontName="Arial" fontSize="8">
