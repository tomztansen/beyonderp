		</band>
	</detail>
	<pageFooter height="14">
		<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000f029" x="544" y="0" width="230" height="14" fontName="Arial" fontSize="8" hTextAlign="Right" vTextAlign="Middle">
