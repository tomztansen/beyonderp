		</element>
		<element kind="textField" uuid="7d2e5b90-0000-4000-8000-000000000b42" x="294" y="0" width="126" height="12" fontName="Arial" fontSize="10" bold="true" hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true" vTextAlign="Middle">
			<expression><![CDATA[$V{sum_wt} == null ? java.math.BigDecimal.ZERO : $V{sum_wt}]]></expression>
