			<element kind="textField" uuid="6d70ca87-8048-4dbf-8009-15aa9cb4ac3b" x="0" y="0" width="78" height="20" fontName="Arial" fontSize="10" pattern="dd-MM-yyyy" blankWhenNull="true" vTextAlign="Middle">
