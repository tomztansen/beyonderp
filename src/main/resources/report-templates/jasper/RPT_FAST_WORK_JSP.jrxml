<?xml version="1.0" encoding="UTF-8"?>
<!-- LAPORAN KERJA HARIAN (Machining, GA/FM/MC-006 Rev. 22-04). Sumber lama: axis lp106.jrxml; tata letak dipertahankan. Report Runner: p_from, p_to (tanggal, wajib), p_operator (msmember.noinduk, wajib). Query ada di template. -->
<jasperReport name="RPT_FAST_WORK_JSP" language="java" pageWidth="2160" pageHeight="612" orientation="Landscape" columnWidth="2120" whenNoDataType="AllSectionsNoDetail" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f54cdfa1-0166-4c4a-a92e-970803bb8890">
	<parameter name="p_from" class="java.time.LocalDate"/>
	<parameter name="p_to" class="java.time.LocalDate"/>
	<parameter name="p_operator" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT c.code,
       (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date AS bookdate,
       f.itemcode, f.itemname, g.salesid, h."name" AS enduser, a.hthardno, d.qty,
       to_char(a.starttime AT TIME ZONE 'Asia/Jakarta', 'HH24:MI') AS start_time,
       to_char(a.endtime   AT TIME ZONE 'Asia/Jakarta', 'HH24:MI') AS end_time,
       CASE WHEN a.processtime ~ '^[0-9]+(\.[0-9]+)?$' THEN a.processtime::numeric END AS processtime,
       i.nama, i.nokartu, j."name" AS chiselname, d.chiselqty
  FROM thbook a
  LEFT JOIN mhresource b ON a.resourceid = b."id"
  LEFT JOIN mdlookup c ON b.msresourceid = c."id"
  LEFT JOIN tdbook d ON a."id" = d.thbookid
  LEFT JOIN tsproductionorder e ON d.tsproductionorderid = e."id"
  LEFT JOIN msitem f ON e.itemid = f."id"
  LEFT JOIN tssalesline g ON e.tssaleslineid = g."id"
  LEFT JOIN mscustomer h ON g.abmenduser = h."id" AND h.enduser = true
  LEFT JOIN msmember i ON a.operatorid = i.id
  LEFT JOIN mdlookup j ON d.chiselid = j.id
 WHERE (lower(c.code) LIKE '%fast%heat%' OR lower(c.code) LIKE '%fast%mach%')
   AND a.bookdate >= $P{p_from}
   AND a.bookdate <  (CAST($P{p_to} AS date) + 1)
   AND i.noinduk = $P{p_operator}
 ORDER BY a.bookdate, a.starttime]]></query>
	<field name="code" class="java.lang.String"/>
	<field name="bookdate" class="java.sql.Date"/>
	<field name="itemcode" class="java.lang.String"/>
	<field name="itemname" class="java.lang.String"/>
	<field name="salesid" class="java.lang.String"/>
	<field name="enduser" class="java.lang.String"/>
	<field name="hthardno" class="java.lang.String"/>
	<field name="qty" class="java.lang.Integer"/>
	<field name="start_time" class="java.lang.String"/>
	<field name="end_time" class="java.lang.String"/>
	<field name="processtime" class="java.math.BigDecimal"/>
	<field name="nama" class="java.lang.String"/>
	<field name="nokartu" class="java.lang.String"/>
	<field name="chiselname" class="java.lang.String"/>
	<field name="chiselqty" class="java.lang.Integer"/>
