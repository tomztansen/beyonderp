<?xml version="1.0" encoding="UTF-8"?>
<!-- Rubber - Production Summary Output (GENERATED oleh gen_rub_summary.py): pengganti 3 report Crystal Synchro Rubber:
     rb-daily.rpt (Summary Production Output - Daily) = tampilan PROCESS, rb-daily2.rpt (... - Daily - Weight) = tampilan DAILY (pivot), sumRub.rpt (Summary Report) = tampilan MONTHLY.
     Aturan berat (keputusan Tommy): Nett Weight = qty x msmethod.netweight (aktual); Product Weight = qty x tdbook.productweight; Blank Weight = qty x qty bahan RP-% pada BOM Rubber produk (mdbom.qty, mhbom resourcegroup 1255);
     Gross (hanya MONTHLY) = qty x msmethod.grossweight. Metal Weight tidak ada aturannya -> tidak ditampilkan. Tahap: booking di resource Rubber (grup 1255), DAILY: Extrusion (=Extruder) & Compression Moulding (=Press);
     MONTHLY: Compression Moulding + Autoclave (kecuali p_process diisi). Metal Making/Method/Metal Preparation tidak ada di GMS. p_subcon INCLUDE|EXCLUDE (thbook.issubcon).
     Query ada di template (data_query kosong). -->
<jasperReport name="RPT_RUB_SUMMARY" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="7d2e5b90-0000-4000-8000-0000000000bb">
	<parameter name="p_from_date" class="java.time.LocalDate"/>
	<parameter name="p_to_date" class="java.time.LocalDate"/>
	<parameter name="p_view" class="java.lang.String"/>
	<parameter name="p_process" class="java.lang.Object"/>
	<parameter name="p_subcon" class="java.lang.String"/>
	<query language="sql"><![CDATA[WITH bk AS (
  SELECT (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date AS dt, r.msresourceid AS resid, c.name AS resname,
         d.qty AS qty,
         d.qty * COALESCE(m.netweight, 0) AS nett,
         d.qty * COALESCE(m.grossweight, 0) AS gross,
         d.qty * COALESCE(d.productweight, 0) AS prod,
         d.qty * COALESCE(bl.rubberqty, 0) AS blank
    FROM thbook a
    JOIN mhresource r ON r.id = a.resourceid AND r.msresourcegroupid = 1255
    JOIN mdlookup c ON c.id = r.msresourceid
    JOIN tdbook d ON d.thbookid = a.id
    LEFT JOIN tsproductionorder o ON o.id = d.tsproductionorderid
    -- berat nett/gross AKTUAL (Nett_Weight/Gross_Weight Synchro) dari metode terbaru yg netweight terisi
    LEFT JOIN LATERAL (SELECT x.netweight, x.grossweight FROM msmethod x
                        WHERE x.itemid = o.itemid AND x.netweight IS NOT NULL ORDER BY x.id DESC LIMIT 1) m ON true
    -- Blank Weight: qty bahan RP-% pada BOM Rubber produk (mdbom.qty, mhbom divisi Rubber)
    LEFT JOIN LATERAL (SELECT SUM(bd.qty) AS rubberqty FROM mhbom bh
                         JOIN mdbom bd ON bd.mhbomid = bh.id
                         JOIN msitem bm ON bm.id = bd.materialid AND bm.itemcode LIKE 'RP-%'
                        WHERE bh.itemid = o.itemid AND bh.resourcegroup = 1255) bl ON true
   WHERE (a.bookdate AT TIME ZONE 'Asia/Jakarta')::date BETWEEN $P{p_from_date} AND $P{p_to_date}
     AND ($P{p_process}::bigint = 0 OR r.msresourceid = $P{p_process}::bigint)
     AND ($P{p_subcon}::text = 'INCLUDE' OR COALESCE(a.issubcon, false) = false)),
days AS (SELECT d::date AS dt FROM generate_series($P{p_from_date}::timestamp, $P{p_to_date}::timestamp, interval '1 day') d)
SELECT 1 AS ord, dt AS d1, to_char(dt, 'YYYY-MM-DD') AS lbl, resname AS lbl2, SUM(qty) AS qty, SUM(nett) AS nett, SUM(prod) AS prod, SUM(blank) AS blank, SUM(gross) AS gross,
       NULL::numeric AS ep, NULL::numeric AS en, NULL::numeric AS eb, NULL::numeric AS cp, NULL::numeric AS cn, NULL::numeric AS cb
  FROM bk WHERE $P{p_view}::text = 'PROCESS' GROUP BY dt, resname
UNION ALL
SELECT 2, days.dt, to_char(days.dt, 'YYYY-MM-DD'), NULL, NULL, NULL, NULL, NULL, NULL,
       COALESCE(SUM(bk.prod) FILTER (WHERE bk.resname ILIKE '%Extrusion%'), 0), COALESCE(SUM(bk.nett) FILTER (WHERE bk.resname ILIKE '%Extrusion%'), 0), COALESCE(SUM(bk.blank) FILTER (WHERE bk.resname ILIKE '%Extrusion%'), 0),
       COALESCE(SUM(bk.prod) FILTER (WHERE bk.resname ILIKE '%Compression%'), 0), COALESCE(SUM(bk.nett) FILTER (WHERE bk.resname ILIKE '%Compression%'), 0), COALESCE(SUM(bk.blank) FILTER (WHERE bk.resname ILIKE '%Compression%'), 0)
  FROM days LEFT JOIN bk ON bk.dt = days.dt WHERE $P{p_view}::text = 'DAILY' GROUP BY days.dt
UNION ALL
SELECT 3, NULL::date, to_char(dt, 'YYYY-MM'), NULL, SUM(qty), SUM(nett), SUM(prod), SUM(blank), SUM(gross),
       NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric, NULL::numeric
  FROM bk WHERE $P{p_view}::text = 'MONTHLY' AND ($P{p_process}::bigint <> 0 OR resname ILIKE '%Compression%' OR resname ILIKE '%Autoclave%')
 GROUP BY to_char(dt, 'YYYY-MM')
 ORDER BY 1, 2, 3, 4]]></query>
