<?xml version="1.0" encoding="UTF-8"?>
<!-- PPIC - Product Update (GENERATED oleh gen_product_update.py): daftar master produk dengan data teknis metode. Pengganti report Crystal Synchro "PPIC - Product Update" (Proddesc.rpt, "Laporan Update File").
     Berbasis msmethod (satu baris per item, hanya produk yang punya metode) JOIN msitem. Pemetaan Synchro -> GMS: Name=msitem.itemcode, Description=itemname, Material(Category_Code)=abmengineermaterialid,
     Est Net/Gross(Spare19/18)=msmethod.estnetweight/estgrossweight, Family=msitem.salescategoryid, Modulus(Spare2)/Hardness(Spare6)=msmethod, Drawing/Rev(PROD_Issues)=msitem.abmdrawingnumber/rev (msmethod.nodwgmould kosong),
     Mould/Box(UID_Lot_Size)=msmethod.pcsperbox, Act Net(Nett_Weight)=msmethod.netweight, Min/Max Temp(Spare15/16)=msmethod.pouringtempmin/max, Business Unit(Spare5)=nama msmethod.msresourcegroupid.
     End User (opsional, p_show_end_user=YES) = pelanggan akhir (tssalesline.abmenduser -> mscustomer) item ini. Kolom kosong Synchro (Marking, Hierarchy, Add Up) tidak dibawa.
     Param: p_product (potongan kode item, kosong = semua), p_show_end_user (YES|NO). Query ada di template (data_query kosong). -->
<jasperReport name="RPT_PRODUCT_UPDATE" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="7d2e5b90-0000-4000-8000-0000000000dd">
	<parameter name="p_product" class="java.lang.String"/>
	<parameter name="p_show_end_user" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT i.itemcode, i.itemname AS descr, i.abmengineermaterialid AS material,
       m.estnetweight AS estnet, m.estgrossweight AS estgross, sc.name AS family,
       m.modulus, m.hardness, i.abmdrawingnumber AS drawing, i.abmdrawingnumberrev AS rev,
       m.pcsperbox, m.netweight AS actnet, m.pouringtempmin AS tmin, m.pouringtempmax AS tmax,
       g.name AS bu, eu.end_user
  FROM msmethod m
  JOIN msitem i ON i.id = m.itemid
  LEFT JOIN mdlookup sc ON sc.id = i.salescategoryid
  LEFT JOIN mdlookup g ON g.id = m.msresourcegroupid
  -- End User (hanya bila p_show_end_user = YES): pelanggan akhir dari baris sales item ini
  LEFT JOIN LATERAL (SELECT string_agg(DISTINCT c.name, ', ' ORDER BY c.name) AS end_user
                       FROM tssalesline s JOIN mscustomer c ON c.id = s.abmenduser AND c.enduser = true
                      WHERE s.itemid = i.id AND $P{p_show_end_user}::text = 'YES') eu ON true
 WHERE ($P{p_product}::text = '' OR i.itemcode ILIKE '%' || $P{p_product}::text || '%')
 ORDER BY i.itemcode]]></query>
	<field name="itemcode" class="java.lang.String"/>
	<field name="descr" class="java.lang.String"/>
	<field name="material" class="java.lang.String"/>
	<field name="estnet" class="java.math.BigDecimal"/>
	<field name="estgross" class="java.math.BigDecimal"/>
	<field name="family" class="java.lang.String"/>
	<field name="modulus" class="java.math.BigDecimal"/>
	<field name="hardness" class="java.lang.String"/>
	<field name="drawing" class="java.lang.String"/>
	<field name="rev" class="java.lang.String"/>
	<field name="pcsperbox" class="java.lang.Long"/>
	<field name="actnet" class="java.math.BigDecimal"/>
	<field name="tmin" class="java.math.BigDecimal"/>
	<field name="tmax" class="java.math.BigDecimal"/>
	<field name="bu" class="java.lang.String"/>
	<field name="end_user" class="java.lang.String"/>
	<title height="60">
