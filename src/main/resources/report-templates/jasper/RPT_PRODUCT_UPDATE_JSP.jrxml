				<expression><![CDATA["Product : " + ($P{p_product} == null || $P{p_product}.isBlank() ? "All" : $P{p_product}) + "     End User : " + ("YES".equals($P{p_show_end_user}) ? "Shown" : "Hidden")]]></expression>
				
			</element>
	</title>
