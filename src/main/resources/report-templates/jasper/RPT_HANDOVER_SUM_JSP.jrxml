<?xml version="1.0" encoding="UTF-8"?>
<!-- Serah terima barang (Foundry) REKAP (satu baris per customer/gas no/code product/OC, no. seri digabung). Sumber lama: axis lp073.jrxml; tata letak dipertahankan. Report Runner: p_from_date, p_to_date (datetime), p_from_resource, p_to_resource (id mdlookup resource; 0 = Finished Good), p_item_scope (ONLY | EXCLUDE: item 3RMCAS*). Judul dan nama asal/tujuan diisi before script lewat p_from_name, p_to_name (juga no. dokumen/rev/eff. date lewat p_doc_*). Query ada di template (data_query kosong). -->
<jasperReport name="RPT_HANDOVER_SUM" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="814" whenNoDataType="AllSectionsNoDetail" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="7d2e5b90-0000-4000-8000-000000000900">
	<parameter name="p_from_date" class="java.time.LocalDateTime"/>
	<parameter name="p_to_date" class="java.time.LocalDateTime"/>
	<parameter name="p_from_resource" class="java.lang.Object"/>
	<parameter name="p_to_resource" class="java.lang.Object"/>
	<parameter name="p_from_name" class="java.lang.String"/>
	<parameter name="p_to_name" class="java.lang.String"/>
	<parameter name="p_item_scope" class="java.lang.String"/>
	<parameter name="p_doc_no" class="java.lang.String"/>
	<parameter name="p_doc_rev" class="java.lang.String"/>
	<parameter name="p_doc_eff" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT h."name" AS customer,
       k.itemcode AS gasno,
       COALESCE(NULLIF(f.itemcode, ''), f.itemname) AS code_product,
       g.salesid AS oc,
       SUM(d.qty)::numeric AS qty,
       string_agg(DISTINCT s.idno, ', ' ORDER BY s.idno) AS serial,
       w.estnetweight::numeric AS weight,
       (SUM(d.qty) * w.estnetweight)::numeric AS total
  FROM thbook a
  JOIN mhresource b ON a.resourceid = b."id"
  JOIN tdbook d ON a."id" = d.thbookid
  LEFT JOIN tsproductionorder e ON d.tsproductionorderid = e."id"
  LEFT JOIN msitem f ON e.itemid = f."id"
  LEFT JOIN tssalesline g ON e.tssaleslineid = g."id"
  LEFT JOIN mscustomer h ON g.abmenduser = h."id" AND h.enduser = true
  LEFT JOIN msitem k ON g.itemsetid = k."id"
  LEFT JOIN tsproductionserial s ON d.serialid = s."id"
  -- berat satuan: satu nilai per item (metode terbaru yang berat netonya terisi); kosong bila belum ada msmethod
  LEFT JOIN LATERAL (SELECT m.estnetweight FROM msmethod m
                      WHERE m.itemid = f."id" AND m.estnetweight IS NOT NULL
                      ORDER BY m."id" DESC LIMIT 1) w ON true
 WHERE a.msresourcegroupid = 1253
   AND b.msresourceid = $P{p_from_resource}::bigint
   AND a.bookdate >= ($P{p_from_date}::timestamp AT TIME ZONE 'Asia/Jakarta')
   AND a.bookdate <= ($P{p_to_date}::timestamp AT TIME ZONE 'Asia/Jakarta')
   -- cakupan item: ONLY = hanya item 3RMCAS*, EXCLUDE = semua item selain 3RMCAS* (dua report terpisah supaya tidak ganda)
   AND (($P{p_item_scope}::text = 'ONLY') = (COALESCE(f.itemcode, '') LIKE '3RMCAS%'))
   -- tujuan: 0 = Finished Good (next 999); selain itu resource pada langkah rute berikutnya (tdbook.next)
   AND (($P{p_to_resource}::bigint = 0 AND d.next = 999)
        OR ($P{p_to_resource}::bigint <> 0 AND d.next <> 999 AND EXISTS (
              SELECT 1 FROM mdroute r
               WHERE r.mhrouteid = e.routeid AND r.sequence = d.next AND r.resourceid = $P{p_to_resource}::bigint)))
 GROUP BY h."name", k.itemcode, f."id", f.itemcode, f.itemname, g.salesid, w.estnetweight
 ORDER BY h."name", k.itemcode, 3, g.salesid]]></query>
	<field name="customer" class="java.lang.String"/>
	<field name="gasno" class="java.lang.String"/>
	<field name="code_product" class="java.lang.String"/>
	<field name="oc" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="serial" class="java.lang.String"/>
	<field name="weight" class="java.math.BigDecimal"/>
	<field name="total" class="java.math.BigDecimal"/>
	<variable name="sum_qty" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{qty}]]></expression>
	</variable>
	<variable name="sum_total" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{total}]]></expression>
	</variable>
