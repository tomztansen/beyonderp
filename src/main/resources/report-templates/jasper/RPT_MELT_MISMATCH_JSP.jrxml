		</element>
		<element kind="staticText" uuid="7d2e5b90-0000-4000-8000-00000000e015" x="662" y="0" width="152" height="16" fontName="Arial" fontSize="9" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[SPK MATERIAL]]></text>
			<box leftPadding="3"><topPen lineWidth="0.75"/><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/><rightPen lineWidth="0.75"/></box>
		</element>
	</columnHeader>
	<detail>
		<band height="14">
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e002" x="0" y="0" width="30" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$V{REPORT_COUNT}]]></expression>
				<box leftPadding="3"><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e004" x="30" y="0" width="72" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle" pattern="dd/MM/yyyy">
				<expression><![CDATA[$F{test_date}]]></expression>
				<box leftPadding="3"><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e006" x="102" y="0" width="90" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[$F{serial_no}]]></expression>
				<box leftPadding="3"><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e008" x="192" y="0" width="80" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[$F{tag_no}]]></expression>
				<box leftPadding="3"><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e010" x="272" y="0" width="100" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[$F{heat_no}]]></expression>
				<box leftPadding="3"><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e012" x="372" y="0" width="140" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
				<expression><![CDATA[$F{product_code}]]></expression>
				<box leftPadding="3"><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
			</element>
			<element kind="textField" uuid="7d2e5b90-0000-4000-8000-00000000e014" x="512" y="0" width="150" height="14" fontName="Arial" fontSize="9" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
