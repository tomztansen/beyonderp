			<text><![CDATA[TAG ID]]></text>
			<box leftPadding="3"><topPen lineWidth="0.75"/><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
		</element>
		<element kind="staticText" uuid="7d2e5b90-0000-4000-8000-00000000e009" x="272" y="0" width="100" height="16" fontName="Arial" fontSize="9" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[HEAT NO]]></text>
			<box leftPadding="3"><topPen lineWidth="0.75"/><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
		</element>
		<element kind="staticText" uuid="7d2e5b90-0000-4000-8000-00000000e011" x="372" y="0" width="140" height="16" fontName="Arial" fontSize="9" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[PRODUCT CODE]]></text>
			<box leftPadding="3"><topPen lineWidth="0.75"/><leftPen lineWidth="0.75"/><bottomPen lineWidth="0.75"/></box>
		</element>
		<element kind="staticText" uuid="7d2e5b90-0000-4000-8000-00000000e013" x="512" y="0" width="150" height="16" fontName="Arial" fontSize="9" bold="true" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[SPECTRO MATERIAL]]></text>
