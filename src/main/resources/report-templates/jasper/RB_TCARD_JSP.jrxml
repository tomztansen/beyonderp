<?xml version="1.0" encoding="UTF-8"?>
<!-- T-Card Rubber: satu kartu per kolom, 3 kolom per halaman A4 (multi-column; 3 salinan dari generate_series). Parameter: p_job (nomor job, wajib), p_type (teks di atas Quantity, mis. NEW). Sumber: tsproductionorder + msitem + tssalesline (abmenduser -> mscustomer) + msmethod (No. Dwg Mould, Process Parameter/nopp, press -> msasset). Kotak label (Mould check dst.) adalah label statis. Required Product sengaja tidak ada. Query ada di template (data_query kosong). -->
<jasperReport name="RB_TCARD_JSP" language="java" pageWidth="595" pageHeight="842" columnCount="3" printOrder="Horizontal" columnWidth="180" columnSpacing="9" leftMargin="20" rightMargin="17" topMargin="29" bottomMargin="10" whenNoDataType="AllSectionsNoDetail" uuid="7c4a1e00-0000-4000-8000-0000000000aa">
	<parameter name="p_job" class="java.lang.String"/>
	<parameter name="p_type" class="java.lang.String"><defaultValueExpression><![CDATA["NEW"]]></defaultValueExpression></parameter>
	<query language="sql"><![CDATA[SELECT p.idno AS job,
       sl.salesid AS oc,
       c.name AS customer,
       i.itemcode AS itemcode,
       i.itemname AS itemname,
       p.qty AS qty,
       i.abmengineermaterialid AS metal,
       NULLIF(btrim(concat_ws(' ', NULLIF(btrim(m.nodwgmould), ''), NULLIF(btrim(m.nodwgmouldrev), ''))), '') AS dwgmould,
       COALESCE(NULLIF(btrim(p.drawingno), ''), i.abmdrawingnumber) AS drawingno,
       CASE WHEN NULLIF(btrim(p.drawingno), '') IS NOT NULL THEN p.drawingnorev ELSE i.abmdrawingnumberrev END AS drawingrev,
       p.criticaldate AS criticaldate,
       a.idname AS press,
       m.nopp AS nopp
  FROM dynamic.tsproductionorder p
  JOIN dynamic.msitem i ON i.id = p.itemid
  LEFT JOIN dynamic.tssalesline sl ON sl.id = p.tssaleslineid
  LEFT JOIN dynamic.mscustomer c ON c.id = sl.abmenduser
  LEFT JOIN LATERAL (SELECT mm.* FROM dynamic.msmethod mm WHERE mm.itemid = i.id ORDER BY mm.id DESC LIMIT 1) m ON TRUE
  LEFT JOIN dynamic.msasset a ON a.id = m.machinepressid
 CROSS JOIN generate_series(1, 3) AS g(n)
 WHERE p.idno = btrim($P{p_job})
 ORDER BY g.n]]></query>
	<field name="job" class="java.lang.String"/>
	<field name="oc" class="java.lang.String"/>
	<field name="customer" class="java.lang.String"/>
	<field name="itemcode" class="java.lang.String"/>
	<field name="itemname" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="metal" class="java.lang.String"/>
	<field name="dwgmould" class="java.lang.String"/>
	<field name="drawingno" class="java.lang.String"/>
	<field name="drawingrev" class="java.lang.String"/>
	<field name="criticaldate" class="java.sql.Date"/>
	<field name="press" class="java.lang.String"/>
	<field name="nopp" class="java.lang.String"/>
